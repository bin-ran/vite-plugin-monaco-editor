{
  "name": "@binran/vite-plugin-monaco-editor",
  "description": "A Vite plugin that simplifies the integration of Monaco Editor with automatic worker handling and language support",
  "version": "0.2.0",
  "type": "module",
  "author": "bin-ran",
  "homepage": "https://github.com/bin-ran/vite-plugin-monaco-editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bin-ran/vite-plugin-monaco-editor.git"
  },
  "keywords": [
    "vite",
    "plugin",
    "monaco-editor",
    "editor",
    "code-editor",
    "typescript",
    "javascript",
    "web-worker"
  ],
  "license": "MIT",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README_zh-CN.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "example:dev": "pnpm build && vite --config example/vite.config.ts",
    "example:build": "pnpm build && vite build --config example/vite.config.ts",
    "example:preview": "vite preview --config example/vite.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "bumpp": "^12.2.1",
    "eslint": "^10.9.1",
    "monaco-editor": "^0.56.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "peerDependencies": {
    "monaco-editor": "^0.56.0",
    "vite": "^8.2.2"
  }
}
